[Unit]
Description=Telie Talkie voice intercom
Wants=network-online.target
After=network-online.target sound.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=telie
Group=telie
SupplementaryGroups=audio
WorkingDirectory=/opt/telie-talkie
LoadCredential=telegram_bot_token:/etc/telie-talkie/bot.token
UnsetEnvironment=TELEGRAM_BOT_TOKEN TELEGRAM_BOT_TOKEN_FILE
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=/opt/telie-talkie/.venv/bin/telie-talkie --config /etc/telie-talkie/config.toml run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=telie-talkie
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
